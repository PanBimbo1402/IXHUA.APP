# Optional server-only values. Never put these in frontend JavaScript.
OPENAI_API_KEY=
REBUILD_AI_MODEL=
OFF_USER_AGENT=
# Staging by default. Set production only when ready for real product lookups.
OFF_ENV=staging
HOST=127.0.0.1
PORT=3000

# One-click owner preview. Uses the same app and API in one process.
# Different from the legacy npm start port to isolate the review origin.
IXHUA_PREVIEW_PORT=4318
# Optional: a private IPv4 address on this computer; otherwise detected.
IXHUA_PREVIEW_ADDRESS=
# Optional trusted HTTPS. Both files must be present; never commit them.
# Certificate must cover the selected LAN IP and localhost for health checks.
IXHUA_PREVIEW_TLS_CERT=
IXHUA_PREVIEW_TLS_KEY=
# Optional hostname on the certificate for the local health probe.
IXHUA_PREVIEW_TLS_SERVERNAME=localhost
